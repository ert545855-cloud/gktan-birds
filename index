<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"><title>Göktan Birds</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>:root{--bg:#1b2a3a;--fg:#fff}@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#10181f}}
html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;overflow:hidden;touch-action:none;-webkit-user-select:none;user-select:none}
body{display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);box-sizing:border-box}
canvas{width:100%;max-width:900px;max-height:100%;aspect-ratio:16/9;background:#8fd3ff}
#hud{padding:6px;font-weight:700;font-size:14px;text-align:center}</style></head><body>
<div id="hud"></div><canvas id="c" width="800" height="450"></canvas>
<script>
const FACE=new Image();FACE.src="data:image/png;base64,";
const cv=document.getElementById('c'),x=cv.getContext('2d'),hud=document.getElementById('hud');
const G=.25,GY=400,SX=130,SY=300;
// b:[x,y,w,h,tip(0 tahta,1 taş)] t:[x,y,tip(0 normal,1 büyük 2hp,2 uçan)]
const LV=[
{n:5,b:[[560,350,60,50,0]],t:[[590,335]]},
{n:5,b:[[500,340,20,60,0],[600,340,20,60,0],[490,320,140,20,0]],t:[[550,385],[560,305]]},
{n:5,b:[[480,350,40,50,0],[580,310,40,90,0],[680,350,40,50,0]],t:[[500,335],[600,295],[700,335],[640,385]]},
{n:4,b:[[520,330,30,70,1],[620,330,30,70,1],[510,310,150,20,0]],t:[[585,385],[585,295]]},
{n:4,w:-.02,b:[[560,340,40,60,0],[600,300,40,100,1]],t:[[580,325],[620,285],[700,385]]},
{n:4,b:[[640,350,50,50,0]],t:[[665,335],[450,200,2],[560,130,2]]},
{n:4,w:.02,b:[[540,340,20,60,1],[640,340,20,60,1],[530,320,140,20,0],[560,260,20,60,0],[620,260,20,60,0],[550,240,90,20,0]],t:[[600,378,1],[600,305],[595,225]]},
{n:5,w:.025,b:[[500,300,30,100,1],[570,300,30,100,1],[640,300,30,100,1],[500,280,170,20,1],[540,200,20,80,0],[610,200,20,80,0],[530,180,110,20,0]],t:[[550,385],[620,385],[585,165],[400,160,2],[730,378,1]]}];
let lv=0,birds,B,T,P,drag=false,mx=0,my=0,st='start',wait=0,fr=0,score=0,lvScore=0,wind=0,parts=[],muted=false,best=0,cd=0;
try{best=+localStorage.getItem('gb_best')||0}catch(e){}
function load(){const L=LV[lv];wind=L.w||0;B=L.b.map(a=>({x:a[0],y:a[1],w:a[2],h:a[3],s:a[4],hp:a[4]?2:1}));
 T=L.t.map(a=>({x:a[0],y:a[1],bx:a[0],by:a[1],r:a[2]==1?22:15,hp:a[2]==1?2:1,fly:a[2]==2,vy:0,fall:0,alive:1,ph:Math.random()*6}));
 birds=L.n;P=null;wait=0;score=lvScore;st='play'}
// ---- SES ----
let AC,mg,mus;
function initAudio(){if(AC){AC.resume();return}try{AC=new (window.AudioContext||window.webkitAudioContext)();mg=AC.createGain();mg.gain.value=.5;mg.connect(AC.destination);startMusic()}catch(e){}}
function tone(f,d,type='sine',v=.2,sl=0,t0=0,dst){if(!AC||muted&&!dst)return;const o=AC.createOscillator(),g=AC.createGain(),t=AC.currentTime+t0;o.type=type;o.frequency.setValueAtTime(f,t);if(sl)o.frequency.exponentialRampToValueAtTime(Math.max(20,f+sl),t+d);g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(g);g.connect(dst||mg);o.start(t);o.stop(t+d+.02)}
function noise(d,v=.3){if(!AC||muted)return;const n=AC.sampleRate*d,b=AC.createBuffer(1,n,AC.sampleRate),a=b.getChannelData(0);for(let i=0;i<n;i++)a[i]=(Math.random()*2-1)*(1-i/n);const s=AC.createBufferSource(),g=AC.createGain();g.gain.value=v;s.buffer=b;s.connect(g);g.connect(mg);s.start()}
const sfx={launch:()=>tone(500,.25,'sawtooth',.15,-380),hit:()=>tone(140,.12,'square',.2,-60),brk:()=>{noise(.25,.4);tone(200,.15,'square',.12,-120)},kill:()=>{tone(600,.18,'square',.2,500);tone(900,.2,'triangle',.15,0,.08)},
 win:()=>[523,659,784,1047].forEach((f,i)=>tone(f,.25,'triangle',.25,0,i*.12)),lose:()=>[392,330,262,196].forEach((f,i)=>tone(f,.3,'sawtooth',.15,0,i*.18))};
const MEL=[392,0,440,523,0,440,392,330,349,0,392,440,0,392,330,0,392,0,440,523,0,587,523,440,392,0,349,330,294,0,330,0];
const BAS=[131,131,175,175,196,196,131,131];
function startMusic(){let i=0;mus=setInterval(()=>{if(muted||!AC)return;const m=MEL[i%32];if(m)tone(m,.22,'triangle',.07);if(i%4==0)tone(BAS[(i/4|0)%8],.5,'sine',.12);if(i%2==0)tone(80,.05,'square',.03);i++},190)}
// ---- GİRDİ ----
function pos(e){const r=cv.getBoundingClientRect(),t=(e.touches&&e.touches[0])||(e.changedTouches&&e.changedTouches[0])||e;return[(t.clientX-r.left)*800/r.width,(t.clientY-r.top)*450/r.height]}
function down(e){initAudio();[mx,my]=pos(e);if(mx>745&&my<45){muted=!muted;return}
 if(st=='start'){load();return}
 if(st=='win'){lvScore=score;lv++;if(lv>=LV.length){st='end';try{if(score>best)localStorage.setItem('gb_best',best=score)}catch(e){}}else load();return}
 if(st=='lose'){load();return}
 if(st=='end'){lv=0;lvScore=0;load();return}
 if(P)return;if(Math.hypot(mx-SX,my-SY)<60)drag=true}
function move(e){if(!drag)return;[mx,my]=pos(e);const dx=mx-SX,dy=my-SY,d=Math.hypot(dx,dy);if(d>80){mx=SX+dx/d*80;my=SY+dy/d*80}}
function up(){if(!drag)return;drag=false;const vx=(SX-mx)*.17,vy=(SY-my)*.17;if(Math.hypot(vx,vy)<2)return;P={x:mx,y:my,vx,vy,a:0,life:0,cd:0};birds--;sfx.launch()}
['mousedown','touchstart'].forEach(n=>cv.addEventListener(n,e=>{e.preventDefault();down(e)}));
['mousemove','touchmove'].forEach(n=>cv.addEventListener(n,e=>{e.preventDefault();move(e)}));
['mouseup','touchend'].forEach(n=>cv.addEventListener(n,up));
// ---- FİZİK ----
function boom(px,py,c,n=10){for(let i=0;i<n;i++)parts.push({x:px,y:py,vx:(Math.random()-.5)*6,vy:-Math.random()*5,l:30,c})}
function hitRect(p,b){const cx=Math.max(b.x,Math.min(p.x,b.x+b.w)),cy=Math.max(b.y,Math.min(p.y,b.y+b.h));const dx=p.x-cx,dy=p.y-cy;return Math.hypot(dx,dy)<20?[dx,dy]:null}
function supported(t){if(t.fly||t.y+t.r>=GY-.5)return true;return B.some(b=>Math.abs(t.y+t.r-b.y)<2&&t.x>b.x-5&&t.x<b.x+b.w+5)}
function kill(t){t.alive=0;score+=100;sfx.kill();boom(t.x,t.y,'#6fcf4a',14)}
function step(){fr++;
 for(const t of T){if(!t.alive)continue;
  if(t.fly){t.x=t.bx+Math.cos(fr*.02+t.ph)*30;t.y=t.by+Math.sin(fr*.03+t.ph)*50;continue}
  if(!supported(t)){t.vy+=G;t.y+=t.vy;t.fall+=t.vy;if(t.y+t.r>=GY)t.y=GY-t.r;
   for(const b of B)if(t.vy>0&&t.x>b.x&&t.x<b.x+b.w&&t.y+t.r>=b.y&&t.y+t.r-t.vy<=b.y+2)t.y=b.y-t.r;
   if(supported(t)){if(t.fall>40)kill(t);t.vy=0;t.fall=0}}}
 if(P){P.vx+=wind;P.vy+=G;P.x+=P.vx;P.y+=P.vy;P.a+=P.vx*.05;P.life++;if(P.cd>0)P.cd--;
  if(P.y>GY-20){P.y=GY-20;if(Math.abs(P.vy)>2)sfx.hit();P.vy*=-.4;P.vx*=.8}
  for(const t of T)if(t.alive&&P.cd==0&&Math.hypot(P.x-t.x,P.y-t.y)<t.r+18){P.cd=12;if(--t.hp<=0)kill(t);else{sfx.hit();boom(t.x,t.y,'#fff',6)}P.vx*=-.5;P.vy*=-.5}
  for(let i=B.length-1;i>=0;i--){const b=B[i],h=hitRect(P,b);if(h){const s=Math.hypot(P.vx,P.vy),thr=b.s?6:3;let gone=false;
   if(s>thr&&--b.hp<=0){B.splice(i,1);gone=true;score+=50;sfx.brk();boom(b.x+b.w/2,b.y+b.h/2,b.s?'#999':'#c98b4b',10);P.vx*=.7;P.vy*=.7}
   else{sfx.hit();const d=Math.hypot(...h)||1;P.vx=h[0]/d*2.5;P.vy=h[1]/d*2.5;P.x+=h[0]/d*4;P.y+=h[1]/d*4}}}
  if(P.x>850||P.x<-50||P.life>450||(P.y>=GY-20&&Math.hypot(P.vx,P.vy)<1))P=null}
 for(const p of parts){p.x+=p.vx;p.y+=p.vy;p.vy+=.3;p.l--}parts=parts.filter(p=>p.l>0);
 if(st=='play'&&!P){if(T.every(t=>!t.alive)){if(++wait>40){score+=birds*200;st='win';sfx.win();if(score>best){best=score;try{localStorage.setItem('gb_best',best)}catch(e){}}}}
  else if(birds<=0&&++wait>90){st='lose';sfx.lose()}}else if(P)wait=0}
// ---- ÇİZİM ----
function face(px,py,a,r){x.save();x.translate(px,py);x.rotate(a);if(FACE.complete)x.drawImage(FACE,-r,-r,2*r,2*r);else{x.fillStyle='#e8b';x.beginPath();x.arc(0,0,r,0,7);x.fill()}x.restore()}
function cloud(cx,cy){x.fillStyle='rgba(255,255,255,.8)';x.beginPath();x.arc(cx,cy,20,0,7);x.arc(cx+22,cy+4,16,0,7);x.arc(cx-20,cy+5,14,0,7);x.fill()}
function overlay(a,b){x.fillStyle='rgba(0,0,0,.65)';x.fillRect(0,150,800,150);x.fillStyle='#fff';x.textAlign='center';x.font='bold 34px system-ui';x.fillText(a,400,215);x.font='18px system-ui';x.fillText(b,400,255);x.textAlign='left'}
function draw(){
 x.clearRect(0,0,800,450);let g=x.createLinearGradient(0,0,0,450);g.addColorStop(0,'#6ec6ff');g.addColorStop(1,'#d8f1ff');x.fillStyle=g;x.fillRect(0,0,800,450);
 x.fillStyle='#ffe066';x.beginPath();x.arc(700,70,28,0,7);x.fill();
 for(let i=0;i<4;i++)cloud(((fr*.2+i*260)%1000)-100,60+i*35);
 x.fillStyle='#5aa83c';x.fillRect(0,GY,800,50);x.fillStyle='#7b4a22';x.fillRect(0,GY+12,800,40);
 x.fillStyle='#6b3d1a';x.fillRect(SX-5,SY+10,10,GY-SY-10);
 if(drag){x.strokeStyle='#3a1f0a';x.lineWidth=5;x.beginPath();x.moveTo(SX-8,SY);x.lineTo(mx,my);x.lineTo(SX+8,SY);x.stroke();
  let px=mx,py=my,vx=(SX-mx)*.17,vy=(SY-my)*.17;x.fillStyle='rgba(255,255,255,.9)';
  for(let i=0;i<22;i++){vx+=wind;vy+=G;px+=vx;py+=vy;if(i%3==0){x.beginPath();x.arc(px,py,3,0,7);x.fill()}}
  face(mx,my,0,20)}else if(!P&&birds>0&&st=='play')face(SX,SY,0,20);
 if(P)face(P.x,P.y,P.a,20);
 for(const b of B){x.fillStyle=b.s?'#8a8f98':'#c98b4b';x.fillRect(b.x,b.y,b.w,b.h);x.strokeStyle=b.s?'#4a4f58':'#7b4a22';x.lineWidth=3;x.strokeRect(b.x,b.y,b.w,b.h);if(b.s&&b.hp<2){x.beginPath();x.moveTo(b.x+4,b.y+8);x.lineTo(b.x+b.w-4,b.y+b.h/2);x.stroke()}}
 for(const t of T){if(!t.alive)continue;x.fillStyle=t.hp>1?'#3fa02a':'#6fcf4a';x.beginPath();x.arc(t.x,t.y,t.r,0,7);x.fill();x.strokeStyle='#2b7a1a';x.lineWidth=2;x.stroke();
  const e=t.r/3;x.fillStyle='#fff';x.beginPath();x.arc(t.x-e,t.y-e/2,e*.8,0,7);x.arc(t.x+e,t.y-e/2,e*.8,0,7);x.fill();x.fillStyle='#000';x.beginPath();x.arc(t.x-e,t.y-e/2,e*.3,0,7);x.arc(t.x+e,t.y-e/2,e*.3,0,7);x.fill();
  if(t.fly){x.fillStyle='#fff';x.beginPath();x.ellipse(t.x-t.r-4,t.y-6,8,4,-.5,0,7);x.ellipse(t.x+t.r+4,t.y-6,8,4,.5,0,7);x.fill()}}
 for(const p of parts){x.fillStyle=p.c;x.fillRect(p.x,p.y,5,5)}
 x.font='24px system-ui';x.fillText(muted?'🔇':'🔊',752,32);
 hud.textContent=st=='start'?'GÖKTAN BİRDS':'Bölüm '+(lv+1)+'/'+LV.length+' • Kafa: '+birds+' • Hedef: '+T.filter(t=>t.alive).length+' • Skor: '+score+' • Rekor: '+best+(wind?' • Rüzgar '+(wind>0?'→':'←'):'');
 if(st=='start')overlay('🎯 GÖKTAN BİRDS','Başlamak için dokun • Sapanı çek, bırak, yeşilleri patlat!');
 else if(st=='win')overlay('🎉 Bölüm geçildi!','Kalan kafa bonusu dahil skor: '+score+' • Devam için dokun');
 else if(st=='lose')overlay('😅 Kafalar bitti!','Tekrar denemek için dokun');
 else if(st=='end')overlay('🏆 Hepsini bitirdin!','Toplam skor: '+score+' • Rekor: '+best+' • Baştan oynamak için dokun');
 else if(lv==0&&birds==LV[0].n&&!drag&&!P){x.fillStyle='#fff';x.font='bold 18px system-ui';x.fillText('Kafayı sapana çek, bırak! 🎯',250,60)}
 if(st=='play'&&lv==3&&birds==LV[3].n&&!drag)x.fillText('',0,0)}
function loop(){if(st!='start')step();draw();requestAnimationFrame(loop)}
loop();
</script></body></html>
